{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/i/:slug", "destination": "/invite.html" },
    { "source": "/dashboard/:slug", "destination": "/dashboard.html" },
    { "source": "/checkin/:slug", "destination": "/checkin.html" },
    { "source": "/api/:path*", "destination": "/api/router?path=:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(i|dashboard|checkin)/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/(img|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
